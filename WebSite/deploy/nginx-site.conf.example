# Docroot: owner/gruppo leggibile da nginx (su Ubuntu: user "www-data").
# Dopo upload come root: chown -R www-data:www-data /var/www/viniliecaffe
# e chmod 755 sulle directory, 644 sui file (lo fa scripts/deploy-site.ps1 via ssh).
server {
    listen 80;
    server_name www.esempio.it esempio.it;
    root /var/www/viniliecaffe;
    index index.html;
    location ~ "^/user/(\d{17,20})/personalizza/?$" {
        try_files /user/personalizza/index.html =404;
    }
    location ~ "^/users/(\d{17,20})/customize/?$" {
        return 301 /user/personalizza/?id=$1&target=rank;
    }
    location = /user/customize { return 301 /user/personalizza/?target=rank; }
    location = /user/customize/ { return 301 /user/personalizza/?target=rank; }
    location = /user/custom { return 301 /user/personalizza/?target=primary; }
    location = /user/custom/ {
        # Keep ?target= via client stub; nginx can't easily rewrite query here.
        try_files /user/custom/index.html =404;
    }
    location ~ "^/users?/(\d{17,20})/?$" {
        try_files /user/index.html =404;
    }
    location = /users { return 301 /user/; }
    location = /users/ { return 301 /user/; }
    # Stesso codice invite di site.config.json (path /api/v10/invites/CODICE?with_counts=true).
    location = /discord-invite.json {
        proxy_pass https://discord.com/api/v10/invites/viniliecaffe?with_counts=true;
        proxy_ssl_server_name on;
        proxy_set_header Host discord.com;
        proxy_set_header Accept application/json;
        add_header Cache-Control "no-store";
    }
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # 404 brandizzata (alias / parent / home gestiti da /js/vc-smart-404.js).
    # Nota: se una location definisce QUALSIASI error_page (es. 405), NON eredita
    # quella del server — ripetere anche `error_page 404 @vc_not_found;`.
    error_page 404 @vc_not_found;
    location @vc_not_found {
        root /var/www/viniliecaffe;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header CDN-Cache-Control "no-store" always;
        try_files /404.html =500;
    }
    location = /404.html {
        root /var/www/viniliecaffe;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header CDN-Cache-Control "no-store" always;
    }
    location = /richieste { return 302 /staff/pause/; }
    location = /richieste/ { return 302 /staff/pause/; }
    location = /richieste/stato { return 302 /staff/pause/; }
    location = /richieste/stato/ { return 302 /staff/pause/; }
    location = /staff/directory { return 302 /staff/organico/; }
    location = /staff/directory/ { return 302 /staff/organico/; }
    location = /staff/valutazioni { return 302 /staff/; }
    location = /staff/valutazioni/ { return 302 /staff/; }

    # HTML: mai in cache (i deploy aggiornano spesso ?v= negli asset).
    # Discord embed color: map User-Agent in conf.d + sub_filter theme-color
    # (deploy/patch-nginx-discord-embed-theme.py). HTML resta #140f0c per la PWA.
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header CDN-Cache-Control "no-store" always;
        # Includere $uri/ qui può dare 403 (cartella senza index, autoindex off), es. /regole incompleto.
        error_page 404 @vc_not_found;
        try_files $uri $uri/index.html =404;
    }

    # JS/CSS: revalidate subito (il ?v= invalida comunque la cache).
    location ^~ /js/ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header CDN-Cache-Control "max-age=0, must-revalidate" always;
        try_files $uri =404;
    }
    location ^~ /css/ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header CDN-Cache-Control "max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    # MP4 Serata Film: non servire in pubblico — stream solo via /webhooks/site-seratafilm-film.
    location = /images/evento-hogwarts/streamingcommunityz-web.mp4 {
        return 404;
    }
    location = /images/evento-hogwarts/streamingcommunityz.mp4 {
        return 404;
    }

    location ^~ /images/ {
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }
}
