# /etc/nginx/conf.d/vc-rate-limit.conf
# Homepage boot: molte GET parallele su /webhooks/site-* — burst troppo basso → 429.

limit_req_zone $binary_remote_addr zone=vc_site_general:16m rate=30r/s;
limit_req_zone $binary_remote_addr zone=vc_site_api:16m rate=60r/s;
limit_req_zone $binary_remote_addr zone=vc_site_static:16m rate=60r/s;
limit_conn_zone $binary_remote_addr zone=vc_site_conn:16m;
