  "devDependencies": {
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001790",
    "dotenv": "^17.4.2",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^4.1.1",
    "tailwindcss": "^3.4.17"
  }
