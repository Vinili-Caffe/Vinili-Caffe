{
  "name": "Sito Ufficiale di Vinili & Caffè",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build && node ../Scripts/flatten-segments.mjs && node ../Scripts/inject-discord-component-embeds.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "check": "node ../Scripts/check-site.mjs",
    "clean": "node -e \"for (const p of ['.next','out','.cache','tsconfig.tsbuildinfo','next-env.d.ts']) { try { require('fs').rmSync(p,{recursive:true,force:true}); console.log('rm',p) } catch (_) {} }\""
  },
  "dependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
