  "type": "module",
  "scripts": {
    "dev:candidature-proxy": "node scripts/dev-candidature-proxy.mjs",
    "build:tailwind": "node ./node_modules/tailwindcss/lib/cli.js -i ./css/tw-input.css -o ./css/tw-build.css --minify",
    "build": "node scripts/build-site.mjs",
    "i18n:extract": "node scripts/extract-i18n-keys.cjs",
    "i18n:generate": "node scripts/generate-i18n-locales.cjs",
    "i18n:bundle": "node scripts/rebuild-i18n-locales-bundle.cjs",
    "i18n:sync": "node scripts/extract-i18n-keys.cjs && node scripts/generate-i18n-locales.cjs && node scripts/rebuild-i18n-locales-bundle.cjs",
    "compress:seratafilm-video": "bash scripts/compress-seratafilm-video.sh",
    "compress:seratafilm-video:remux": "VC_SERATAFILM_REMUX_ONLY=1 bash scripts/compress-seratafilm-video.sh",
    "refresh-live-stats-extra": "node scripts/build-site.mjs --only-live-stats-extra",
    "list-guild-roles": "node scripts/list-guild-roles.mjs"
