# Non collegare token/Mongo/Lavalink live finché non sei pronto (conflitto col bot JS).
BOT_LABEL=vinyls-ts
BOT_PREFIX=+
# Preferisci DISCORD_TOKEN locale; altrimenti Vinyls→DISCORD_TOKEN_OFFICIAL, Coffee→DISCORD_TOKEN_TEST (root .env)
DISCORD_TOKEN=
# Cutover: ferma PM2 JS prima di login con gli stessi token
VC_TS_CUTOVER=0
MONGODB_URI=
LOG_LEVEL=info
HEALTH_PORT=0

# Mongo: solo collezioni bots_ts_* (non schema live)
VC_TS_MONGO=0
# Dual-READ schema live (nessun write prod)
VC_TS_LIVE_MONGO_READ=0
VC_TS_LIVE_EXP_COLLECTION=
VC_TS_LIVE_WALLET_COLLECTION=
VC_TS_ACTIVITY_FLUSH_MS=30000
VC_TS_ECONOMY_FLUSH_MS=30000

# Modlog / level-up / boost / join-gate
VC_TS_MODLOG_CHANNEL=
VC_TS_LEVEL_UP_CHANNEL=
VC_TS_LEVEL_ROLES=
VC_TS_BOOST_CHANNEL=
VC_TS_JOIN_GATE_ROLE=
VC_TS_VERIFY_ROLE=
VC_TS_EXP_IGNORE_CHANNELS=
VC_TS_EXP_IGNORE_ROLES=

# Music — nodo ISOLATO dal JS live
VC_TS_LAVALINK=0
VC_TS_LAVALINK_CONNECT=0
# obbligatorio con CONNECT=1 (nodo dedicato, non quello del bot JS)
VC_TS_LAVALINK_ALLOW_SHARED=0
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# Automod / antinuke
VC_TS_AUTOMOD=
VC_TS_ANTINUKE=
VC_TS_ANTINUKE_ENFORCE=0

# Economy shop JSON opzionale
VC_TS_SHOP_JSON=

# MultiGuild tenants JSON
VC_TS_TENANTS=

# Coffee
VC_TS_CHAT_REMINDER_CHANNEL=
VC_TS_CHAT_REMINDER_MS=
# Markov autosend (solo coffee-ts; off di default)
VC_TS_MARKOV_AUTOSEND=0
VC_TS_MARKOV_MIN_CORPUS=30
VC_TS_MARKOV_MIN_GAP=15
VC_TS_MARKOV_MAX_GAP=40
VC_TS_MARKOV_MIN_SEND_GAP_MS=45000

# Plugin eventi: hogwarts,starwars,halloween
VC_PLUGINS=

# Slash guild register (giveaway, …)
VC_TS_SLASH_GUILD=

# Vote webhooks (Keep) — porta dedicata
VC_TS_WEBHOOK_PORT=0
DISCADIA_VOTE_HTTP_WEBHOOK=0
TOPGG_VOTE_HTTP_WEBHOOK=0
DISCADIA_WEBHOOK_SECRET=
TOPGG_WEBHOOK_SECRET=

# Community / staff loops
VC_TS_BIRTHDAY_CHANNEL=
VC_TS_BIRTHDAYS=
VC_TS_WEEKLY_WINNERS_CHANNEL=
VC_TS_STAFFER_WEEK_CHANNEL=
VC_TS_AUTO_VAL_CHANNEL=
VC_TS_AUDIT_CHANNEL=
VC_TS_COMMUNITY_OPS_ENFORCE=0
VC_TS_CLAN_TAG_ROLE=
VC_TS_SPONSOR_ROLE=
VC_TS_MAIN_ROLE=
VC_TS_VOICE_CAPTURE=0
VC_VOICE_PCM_RING_SEC=20
VC_TS_HOGWARTS_EVENT_KEY=default

# Markov keeper HTTP (coffee)
VC_TS_MARKOV_KEEPER_PORT=0
VC_TS_MARKOV_KEEPER_HOST=127.0.0.1
