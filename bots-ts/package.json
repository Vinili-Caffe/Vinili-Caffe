{
  "name": "@vinili-caffe/bots-ts",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript rewrite of Vinyls/Coffee bots (isolated from live JS)",
  "main": "dist/vinyls/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "dev:vinyls": "node ./node_modules/tsx/dist/cli.mjs src/vinyls/index.ts",
    "dev:coffee": "node ./node_modules/tsx/dist/cli.mjs src/coffee/index.ts",
    "start:vinyls": "node dist/vinyls/index.js",
    "start:coffee": "node dist/coffee/index.js",
    "worker:community-poll": "node dist/workers/communityPoll.js",
    "worker:bot-scheduler": "node dist/workers/botScheduler.js",
    "worker:vote-drain": "node dist/workers/voteDrain.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@napi-rs/canvas": "^1.0.13",
    "discord.js": "14.25.1",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "mongodb": "^6.21.0",
    "opusscript": "^0.0.8",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "UNLICENSED"
}
