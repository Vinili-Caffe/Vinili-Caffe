{
  // Controllo dei tipi dei bot in TypeScript (npm run check). La compilazione vera la fa tools/build.mjs.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "moduleDetection": "force",
    "types": ["node"],
    // canvas: dopo promote sta in ../Vinyls; in pre-promote prova anche dist/
    "baseUrl": ".",
    "paths": {
      "canvas": ["../Vinyls/node_modules/canvas", "./dist/Vinyls/node_modules/canvas"]
    },
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // severità di partenza (il codice viene da JavaScript): si alza man mano che i tipi migliorano
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
