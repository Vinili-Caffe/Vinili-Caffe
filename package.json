{
  "name": "vinili-caffe-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace per bot Ufficiale e Test",
  "main": "loader.js",
  "workspaces": [
    "Vinyls",
    "Coffee"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning loader.js",
    "start:wait-lavalink": "node wait-for-lavalink.js",
    "start:official": "npm run start --workspace=Vinyls",
    "start:test": "npm run start --workspace=Coffee",
    "install:bots": "npm install --legacy-peer-deps --prefix Vinyls && npm install --legacy-peer-deps --prefix Coffee",
    "i18n:site": "npm run i18n:sync --prefix WebSite",
    "i18n:tenant": "node Vinyls/Utils/Partner/tenantPartnershipI18n/scripts/generate-tenant-i18n.cjs",
    "votes:backfill": "node scripts/backfill-votes-from-supporters.js",
    "dm:banned-unban": "node scripts/dm-banned-unban-link.js"
  },
  "dependencies": {
    "discord.js": "14.25.1"
  },
  "overrides": {
    "discord.js": "14.25.1"
  },
  "nodeVersion": "24.7.0",
  "file": "loader.js",
  "author": "lXo",
  "license": "UNLICENSED",
  "copyright": "Copyright (c) 2024–2026 Vinili & Caffè. Tutti i diritti riservati."
}